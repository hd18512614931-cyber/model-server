<view class="container">
  <view class="header">
    <text class="title">佛山年画 3D 展厅</text>
    <text class="subtitle">点击模型卡片进入 3D 查看</text>
  </view>

  <view class="grid">
    <view class="card" wx:for="{{models}}" wx:key="file" bindtap="onModelTap" data-item="{{item}}">
      <view class="card-icon" style="background-color: {{item.color}};">
        <text class="emoji">{{item.emoji}}</text>
      </view>
      <text class="card-name">{{item.name}}</text>
    </view>
  </view>
</view>
