/* pages/create/create.wxss */
.container {
  padding: 40rpx;
  background-color: #FAFAFA;
  min-height: 100vh;
  box-sizing: border-box;
}

.header {
  margin-bottom: 50rpx;
}

.title {
  display: block;
  font-size: 40rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 16rpx;
}

.subtitle {
  display: block;
  font-size: 26rpx;
  color: #999999;
}

/* 上传区域虚线框与预览样式 */
.upload-section {
  width: 100%;
  height: 600rpx;
  background-color: #FFFFFF;
  border-radius: 24rpx;
  margin-bottom: 50rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.04);
  position: relative;
  overflow: hidden;
}

.upload-area {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  border: 4rpx dashed #E0E0E0;
  border-radius: 20rpx;
  box-sizing: border-box;
  margin: 20rpx;
  width: calc(100% - 40rpx);
  height: calc(100% - 40rpx);
}

.upload-icon {
  font-size: 80rpx;
  color: #CCCCCC;
  font-weight: 300;
  margin-bottom: 20rpx;
}

.upload-text {
  font-size: 28rpx;
  color: #888888;
}

.preview-area {
  width: 100%;
  height: 100%;
  position: relative;
  background-color: #f5f5f5;
}

.preview-img {
  width: 100%;
  height: 100%;
}

.reselect-btn {
  position: absolute;
  bottom: 30rpx;
  right: 30rpx;
  background-color: rgba(0, 0, 0, 0.6);
  color: #FFFFFF;
  padding: 10rpx 30rpx;
  border-radius: 40rpx;
  font-size: 24rpx;
}

/* 风格横向标签滚动样式 */
.style-section {
  margin-bottom: 60rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 24rpx;
}

.style-scroll {
  width: 100%;
  white-space: nowrap;
}

.style-list {
  display: inline-flex;
  padding-bottom: 10rpx;
}

.style-item {
  padding: 12rpx 32rpx;
  background-color: #F0F0F0;
  color: #666666;
  border-radius: 40rpx;
  font-size: 26rpx;
  margin-right: 20rpx;
  border: 2rpx solid transparent;
  transition: all 0.3s ease;
}

.style-item.active {
  background-color: rgba(217, 40, 28, 0.1);
  color: #D9281C; /* 主题红色 */
  border-color: #D9281C;
}

/* 按钮样式 */
.footer-btn {
  width: 100%;
  padding-bottom: env(safe-area-inset-bottom);
}

.submit-btn {
  background-color: #D9281C;
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: bold;
  border-radius: 48rpx;
  padding: 24rpx 0;
  line-height: 1.5;
  box-shadow: 0 12rpx 24rpx rgba(217, 40, 28, 0.3);
}

.submit-btn[disabled] {
  background-color: #ff9d96 !important;
  color: #ffffff !important;
  box-shadow: none !important;
}
