page {
  background: #0f0c0b;
}

.create-page {
  min-height: 100vh;
  padding: 60rpx 40rpx;
  box-sizing: border-box;
}

.create-header {
  text-align: center;
  margin-bottom: 60rpx;
}

.create-title {
  display: block;
  color: #F8E5A9;
  font-size: 44rpx;
  font-weight: 900;
  letter-spacing: 4rpx;
  margin-bottom: 16rpx;
}

.create-subtitle {
  display: block;
  color: rgba(255, 255, 255, 0.5);
  font-size: 26rpx;
}

.upload-area {
  width: 100%;
  height: 480rpx;
  border: 3rpx dashed rgba(248, 229, 169, 0.3);
  border-radius: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: rgba(248, 229, 169, 0.03);
  margin-bottom: 40rpx;
}

.upload-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.upload-text {
  color: #F8E5A9;
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.upload-hint {
  color: rgba(255, 255, 255, 0.35);
  font-size: 24rpx;
}

.preview-area {
  width: 100%;
  margin-bottom: 40rpx;
}

.preview-img {
  width: 100%;
  height: 480rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.05);
}

.preview-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 30rpx;
}

.action-btn {
  flex: 1;
  height: 88rpx;
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
}

.action-reselect {
  background: rgba(255, 255, 255, 0.08);
  color: rgba(255, 255, 255, 0.7);
  border: 1rpx solid rgba(255, 255, 255, 0.15);
}

.action-analyze {
  background: linear-gradient(135deg, #C41E3A, #aa1a10);
  color: #fff;
  box-shadow: 0 8rpx 24rpx rgba(196, 30, 58, 0.3);
}

.action-analyzing {
  background: rgba(196, 30, 58, 0.4);
  color: rgba(255, 255, 255, 0.7);
  gap: 12rpx;
}

.mini-loading {
  width: 32rpx;
  height: 32rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.2);
  border-top-color: #fff;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.history-entry {
  display: flex;
  align-items: center;
  padding: 28rpx 32rpx;
  background: rgba(255, 241, 207, 0.06);
  border: 1rpx solid rgba(248, 229, 169, 0.15);
  border-radius: 20rpx;
  margin-top: 40rpx;
}

.history-icon {
  font-size: 40rpx;
  margin-right: 20rpx;
}

.history-text {
  flex: 1;
  color: #F8E5A9;
  font-size: 28rpx;
  font-weight: 600;
}

.history-arrow {
  color: rgba(248, 229, 169, 0.5);
  font-size: 32rpx;
}
