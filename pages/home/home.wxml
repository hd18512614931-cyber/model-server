<view class="page-root">
  <video
    class="global-bg-video"
    src="https://model-server-rosy.vercel.app/knowledge/nianhua-story.mp4"
    autoplay
    loop
    muted
    object-fit="cover"
    show-play-btn="{{false}}"
    show-center-play-btn="{{false}}"
    controls="{{false}}"
    enable-progress-gesture="{{false}}"
  ></video>
  <view class="global-overlay"></view>

  <view class="music-btn {{musicPlaying ? 'spinning' : ''}}" bindtap="toggleMusic">
    <text class="music-icon">{{musicPlaying ? '♫' : '♪'}}</text>
  </view>

  <view class="nav-dots">
    <view
      wx:for="{{9}}"
      wx:key="index"
      class="dot {{currentPage===index?'active':''}}"
      bindtap="goToPage"
      data-page="{{index}}"
    ></view>
  </view>

  <swiper
    class="main-swiper"
    vertical="{{true}}"
    duration="{{500}}"
    easing-function="easeInOutCubic"
    bindchange="onSwiperChange"
    current="{{currentPage}}"
  >
    <swiper-item>
      <view class="screen screen-1">
        <view class="s1-content">
          <view class="s1-line"></view>
          <text class="s1-subtitle">非遗 · 数字体验</text>
          <text class="s1-title">佛山木版年画</text>
          <text class="s1-desc">刀锋与木纹之间，藏着三百年的故事</text>
        </view>
        <view class="s1-bottom">
          <view class="scroll-arrow">
            <text class="arrow-text">↓</text>
          </view>
        </view>
      </view>
    </swiper-item>

    <swiper-item>
      <view class="screen screen-2">
        <view class="s2-header">
          <text class="s2-label">溯 源</text>
        </view>
        <view class="timeline">
          <view class="tl-line"></view>

          <view class="tl-node {{currentEra===0?'tl-active':''}}" bindtap="onEraTap" data-index="0">
            <view class="tl-dot"></view>
            <view class="tl-content">
              <text class="tl-year">1736</text>
              <text class="tl-era-name">清 · 乾隆年间</text>
              <text class="tl-one-line">年画店铺两百余家，从业者数千人</text>
            </view>
          </view>

          <view class="tl-node {{currentEra===1?'tl-active':''}}" bindtap="onEraTap" data-index="1">
            <view class="tl-dot"></view>
            <view class="tl-content">
              <text class="tl-year">1912</text>
              <text class="tl-era-name">民国 · 变革时期</text>
              <text class="tl-one-line">机器印刷冲击下的艰难坚守</text>
            </view>
          </view>

          <view class="tl-node {{currentEra===2?'tl-active':''}}" bindtap="onEraTap" data-index="2">
            <view class="tl-dot"></view>
            <view class="tl-content">
              <text class="tl-year">2006</text>
              <text class="tl-era-name">当代 · 非遗传承</text>
              <text class="tl-one-line">首批国家级非物质文化遗产</text>
            </view>
          </view>

          <view class="tl-node {{currentEra===3?'tl-active':''}}" bindtap="onEraTap" data-index="3">
            <view class="tl-dot dot-future"></view>
            <view class="tl-content">
              <text class="tl-year">2025</text>
              <text class="tl-era-name">未来 · 数字新生</text>
              <text class="tl-one-line">AI与年画的第一次对话</text>
            </view>
          </view>
        </view>
      </view>
    </swiper-item>

    <swiper-item>
      <view class="screen screen-color">
        <text class="screen-label">工 艺</text>
        <text class="screen-heading">五色套印</text>

        <view class="color-row">
          <view
            wx:for="{{colors}}"
            wx:key="index"
            class="color-circle {{activeColor === index ? 'color-active' : ''}} {{animatingIndex === index ? 'color-animating' : ''}}"
            style="background:{{item.color}};"
            data-index="{{index}}"
            bindtap="selectColor"
          >
            <text class="color-order" style="color:{{item.textColor}};">{{item.order}}</text>
          </view>
        </view>

        <view class="anim-btn {{isAnimating?'anim-btn-disabled':''}}" bindtap="playColorSequence">
          <text>{{isAnimating ? '演示中…' : '▶ 演示套印顺序'}}</text>
        </view>

        <text
          wx:if="{{isAnimating && animatingIndex >= 0 && animatingIndex < colors.length}}"
          class="step-text"
        >第{{colors[animatingIndex].order}}步 · 印{{colors[animatingIndex].name}}</text>

        <view wx:if="{{activeColor >= 0}}" class="color-info">
          <text class="color-info-name" style="color:{{colors[activeColor].color}};">
            {{colors[activeColor].name}}
          </text>
          <text class="color-info-line">颜料：{{colors[activeColor].material}}</text>
          <text class="color-info-line">寓意：{{colors[activeColor].meaning}}</text>
          <text class="color-info-line">顺序：第 {{colors[activeColor].order}} 版</text>
          <text class="color-info-desc">{{colors[activeColor].desc}}</text>
        </view>
      </view>
    </swiper-item>

    <swiper-item>
      <view class="screen screen-cards">
        <text class="screen-label">图 鉴</text>
        <text class="screen-heading">年画图鉴</text>
        <text class="screen-hint">点击卡片翻转探索</text>

        <view class="cards-grid">
          <view
            wx:for="{{cards}}"
            wx:key="index"
            class="flip-container"
            data-index="{{index}}"
            bindtap="flipCard"
          >
            <view class="flip-inner {{item.flipped ? 'flipped' : ''}}">
              <view class="flip-front">
                <image src="{{baseUrl}}{{item.image}}" mode="aspectFill" class="flip-img" lazy-load></image>
                <text class="flip-name">{{item.title}}</text>
              </view>
              <view class="flip-back">
                <text class="flip-back-cat">{{item.category}}</text>
                <text class="flip-back-title">{{item.title}}</text>
                <text class="flip-back-desc">{{item.desc}}</text>
              </view>
            </view>
          </view>
        </view>
      </view>
    </swiper-item>

    <swiper-item>
      <view class="screen screen-quiz">
        <text class="screen-label">测 验</text>
        <text class="screen-heading">考考你</text>

        <block wx:if="{{!quizFinished}}">
          <text class="quiz-progress">{{currentQuestion + 1}} / {{quiz.length}}</text>
          <text class="quiz-question">{{quiz[currentQuestion].question}}</text>

          <view class="quiz-options">
            <view
              wx:for="{{quiz[currentQuestion].options}}"
              wx:key="index"
              wx:for-item="option"
              class="quiz-opt {{showExplanation && index === quiz[currentQuestion].answer ? 'quiz-correct' : ''}} {{showExplanation && index === selectedOption && index !== quiz[currentQuestion].answer ? 'quiz-wrong' : ''}}"
              data-index="{{index}}"
              bindtap="selectQuizOption"
            >
              <text>{{option}}</text>
            </view>
          </view>

          <view wx:if="{{showExplanation}}" class="quiz-explain">
            <text>{{quiz[currentQuestion].explanation}}</text>
          </view>
        </block>

        <block wx:if="{{quizFinished}}">
          <view class="quiz-result">
            <text class="quiz-score-num">{{quizScore}}/{{quiz.length}}</text>
            <text wx:if="{{quizScore === 3}}" class="quiz-msg">年画大师！了如指掌。</text>
            <text wx:elif="{{quizScore === 2}}" class="quiz-msg">不错，已有不少了解。</text>
            <text wx:elif="{{quizScore === 1}}" class="quiz-msg">继续探索，精彩无限。</text>
            <text wx:else class="quiz-msg">没关系，往回滑看看知识点。</text>
            <view class="quiz-reset" bindtap="resetQuiz">
              <text>重新答题</text>
            </view>
          </view>
        </block>
      </view>
    </swiper-item>

    <swiper-item>
      <view class="screen screen-video">
        <text class="screen-label">影 像</text>
        <text class="screen-heading">记录与传承</text>

        <view class="video-list">
          <view class="video-item">
            <text class="video-item-title">木版年画制作工艺</text>
            <video
              class="video-player"
              src="https://model-server-rosy.vercel.app/knowledge/nianhua-making.mp4"
              poster="https://model-server-rosy.vercel.app/knowledge/coloring-closeup.jpg"
              controls
              enable-play-gesture
              show-center-play-btn
              object-fit="contain"
            ></video>
          </view>

          <view class="video-item">
            <text class="video-item-title">年画故事与传承</text>
            <video
              class="video-player"
              src="https://model-server-rosy.vercel.app/knowledge/nianhua-story.mp4"
              poster="https://model-server-rosy.vercel.app/knowledge/baxian.jpg"
              controls
              enable-play-gesture
              show-center-play-btn
              object-fit="contain"
            ></video>
          </view>
        </view>
      </view>
    </swiper-item>

    <swiper-item>
      <view class="screen screen-3">
        <view class="s3-header">
          <text class="section-label">展 厅</text>
        </view>
        <scroll-view scroll-x class="s3-preview" enhanced show-scrollbar="{{false}}">
          <image
            wx:for="{{previewImages}}"
            wx:key="*this"
            src="{{item}}"
            mode="aspectFill"
            class="s3-preview-img"
            lazy-load
          ></image>
        </scroll-view>
        <view class="gallery-split">
          <view class="gallery-half gallery-3d" bindtap="goTo3D">
            <text class="gallery-label">3D 展厅</text>
            <text class="gallery-hint">沉浸 · 旋转 · 探索</text>
            <text class="gallery-arrow">→</text>
          </view>
          <view class="gallery-divider"></view>
          <view class="gallery-half gallery-2d" bindtap="goTo2D">
            <text class="gallery-label">2D 展厅</text>
            <text class="gallery-hint">经典 · 高清 · 细赏</text>
            <text class="gallery-arrow">→</text>
          </view>
        </view>
      </view>
    </swiper-item>

    <swiper-item>
      <view class="screen screen-4">
        <view class="s4-content">
          <text class="s4-line1">传统不只在博物馆</text>
          <text class="s4-line2">更在你的指尖</text>
          <view class="s4-btn" bindtap="goToCreate">
            <text class="s4-btn-text">开启 AI 创作</text>
          </view>
        </view>
        <view class="s4-footer">
          <text class="footer-text">佛山木版年画 · 数字体验</text>
          <text class="footer-text">2025</text>
        </view>
      </view>
    </swiper-item>

    <swiper-item>
      <view class="screen screen-team">
        <text class="screen-label">关 于</text>
        <text class="screen-heading">年画薪传突击队</text>

        <view class="team-divider"></view>

        <text class="team-desc">
          我们是一群热爱传统文化的大学生，
          用数字技术让非遗走进年轻人的世界。
        </text>

        <view class="team-info">
          <text class="team-line">广东工业大学 · 数据科学专业</text>
          <text class="team-line">2025 毕业设计作品</text>
        </view>

        <view class="team-footer">
          <text class="team-footer-text">佛山木版年画 · 数字体验</text>
          <text class="team-footer-year">2025</text>
        </view>
      </view>
    </swiper-item>
  </swiper>

  <view class="era-modal" wx:if="{{showEraDetail}}" bindtap="closeEraDetail">
    <view class="era-modal-content" catchtap="noop">
      <view class="era-modal-close" bindtap="closeEraDetail">✕</view>
      <text class="era-modal-year">{{eraDetail.year}}</text>
      <text class="era-modal-title">{{eraDetail.title}}</text>
      <scroll-view
        wx:if="{{eraDetail.images && eraDetail.images.length > 0}}"
        scroll-x
        class="era-modal-gallery"
        enhanced
        show-scrollbar="{{false}}"
      >
        <image
          wx:for="{{eraDetail.images}}"
          wx:key="*this"
          src="{{item}}"
          mode="aspectFill"
          class="era-modal-gallery-img"
          bindtap="previewImage"
          data-src="{{item}}"
          data-urls="{{eraDetail.images}}"
        ></image>
      </scroll-view>
      <text class="era-modal-text">{{eraDetail.desc}}</text>
      <view wx:if="{{eraDetail.hasVideo}}" class="era-modal-video-wrap">
        <video
          src="https://model-server-rosy.vercel.app/knowledge/nianhua-making.mp4"
          controls
          enable-play-gesture
          show-center-play-btn
          object-fit="contain"
          class="era-modal-video"
        ></video>
      </view>
      <view wx:if="{{eraDetail.isLast}}" class="era-modal-btn" bindtap="goToCreate">
        <text>体验 AI 二创 →</text>
      </view>
    </view>
  </view>
</view>
