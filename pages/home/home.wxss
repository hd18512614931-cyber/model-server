page {
  width: 100%;
  height: 100%;
  background: #000000;
  overflow: hidden;
}

.page-root {
  width: 100vw;
  height: 100vh;
  overflow: hidden;
  position: relative;
  background: #000000;
}

.global-bg-video {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  z-index: 0;
  object-fit: cover;
  pointer-events: none;
}

.global-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  z-index: 1;
  background: rgba(0, 0, 0, 0.5);
  pointer-events: none;
}

.main-swiper {
  position: relative;
  z-index: 2;
  width: 100vw;
  height: 100vh;
}

.screen {
  height: 100vh;
  width: 100vw;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  position: relative;
}

.music-btn {
  position: fixed;
  top: 72rpx;
  right: 32rpx;
  z-index: 20;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.08);
  border: 1rpx solid rgba(255, 255, 255, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
}

.music-icon {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.7);
}

.music-btn.spinning {
  animation: spin 4s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.nav-dots {
  position: fixed;
  right: 32rpx;
  top: 50%;
  transform: translateY(-50%);
  z-index: 20;
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}

.dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
  transition: all 0.4s ease;
}

.dot.active {
  background: #D42F2F;
  box-shadow: 0 0 16rpx rgba(212, 47, 47, 0.5);
  transform: scale(1.6);
}

.screen-1 {
  justify-content: center;
  align-items: center;
}

.s1-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
}

.s1-subtitle {
  font-size: 24rpx;
  letter-spacing: 0;
  color: rgba(255, 255, 255, 0.4);
  text-transform: uppercase;
}

.s1-title {
  font-size: 80rpx;
  font-weight: 200;
  color: #ffffff;
  letter-spacing: 0;
  animation: fadeUp 1.5s ease-out 0.2s both;
}

.s1-desc {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.45);
  letter-spacing: 0;
  margin-top: 16rpx;
  animation: fadeUp 1.5s ease-out 0.8s both;
}

.s1-bottom {
  position: absolute;
  bottom: 120rpx;
  left: 0;
  right: 0;
  display: flex;
  justify-content: center;
}

.scroll-arrow {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.arrow-text {
  font-size: 40rpx;
  color: rgba(255, 255, 255, 0.3);
  animation: float 2.5s ease-in-out infinite;
}

@keyframes float {
  0%,
  100% {
    transform: translateY(0);
    opacity: 0.3;
  }

  50% {
    transform: translateY(20rpx);
    opacity: 0.6;
  }
}

@keyframes fadeUp {
  from {
    opacity: 0;
    transform: translateY(30rpx);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.screen-2 {
  justify-content: center;
  padding: 0 64rpx;
}

.s2-header {
  margin-bottom: 64rpx;
}

.s2-label {
  font-size: 20rpx;
  letter-spacing: 0;
  color: rgba(255, 255, 255, 0.3);
}

.timeline {
  position: relative;
  padding-left: 48rpx;
}

.tl-line {
  position: absolute;
  left: 8rpx;
  top: 12rpx;
  bottom: 12rpx;
  width: 1rpx;
  background: rgba(255, 255, 255, 0.12);
}

.tl-node {
  position: relative;
  padding: 28rpx 0 28rpx 40rpx;
  transition: all 0.4s ease;
}

.tl-dot {
  position: absolute;
  left: -6rpx;
  top: 40rpx;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.25);
  border: 1rpx solid rgba(255, 255, 255, 0.15);
  transition: all 0.4s ease;
}

.tl-active .tl-dot {
  background: #D42F2F;
  border-color: #D42F2F;
  box-shadow: 0 0 20rpx rgba(212, 47, 47, 0.4);
}

.dot-future {
  background: #F2C94C !important;
  border-color: #F2C94C !important;
}

.tl-active .dot-future {
  box-shadow: 0 0 20rpx rgba(242, 201, 76, 0.4) !important;
}

.tl-content {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.tl-year {
  font-size: 52rpx;
  font-weight: 100;
  color: rgba(255, 255, 255, 0.15);
  letter-spacing: 0;
  line-height: 1;
  transition: all 0.4s ease;
}

.tl-active .tl-year {
  color: rgba(255, 255, 255, 0.6);
}

.tl-era-name {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.7);
  font-weight: 500;
  letter-spacing: 0;
}

.tl-one-line {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.35);
  letter-spacing: 0;
}

.screen-3 {
  padding: 0;
}

.gallery-split {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
}

.gallery-half {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  gap: 16rpx;
  position: relative;
  transition: background 0.3s ease;
}

.gallery-3d {
  background: rgba(212, 47, 47, 0.08);
}

.gallery-2d {
  background: rgba(45, 93, 161, 0.08);
}

.gallery-3d:active {
  background: rgba(212, 47, 47, 0.2);
}

.gallery-2d:active {
  background: rgba(45, 93, 161, 0.2);
}

.gallery-divider {
  width: 60%;
  height: 1rpx;
  background: rgba(255, 255, 255, 0.1);
  align-self: center;
}

.gallery-label {
  font-size: 48rpx;
  font-weight: 200;
  color: #ffffff;
  letter-spacing: 0;
}

.gallery-hint {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.35);
  letter-spacing: 0;
}

.gallery-arrow {
  font-size: 36rpx;
  color: rgba(255, 255, 255, 0.2);
  margin-top: 16rpx;
}

.screen-4 {
  justify-content: center;
  align-items: center;
}

.s4-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.s4-line1 {
  font-size: 40rpx;
  font-weight: 300;
  color: rgba(255, 255, 255, 0.6);
  letter-spacing: 0;
}

.s4-line2 {
  font-size: 52rpx;
  font-weight: 200;
  color: #ffffff;
  letter-spacing: 0;
  margin-bottom: 80rpx;
}

.s4-btn {
  padding: 28rpx 80rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.3);
  border-radius: 60rpx;
  background: rgba(255, 255, 255, 0.06);
  transition: all 0.3s ease;
}

.s4-btn:active {
  background: rgba(212, 47, 47, 0.3);
  border-color: #D42F2F;
}

.s4-btn-text {
  font-size: 30rpx;
  color: #ffffff;
  letter-spacing: 0;
  font-weight: 300;
}

.era-modal {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  z-index: 100;
  background: rgba(0, 0, 0, 0.85);
  display: flex;
  align-items: center;
  justify-content: center;
  animation: fadeIn 0.3s ease;
}

.era-modal-content {
  width: 85vw;
  max-height: 80vh;
  overflow-y: auto;
  background: rgba(30, 15, 5, 0.9);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 24rpx;
  padding: 60rpx 48rpx;
  position: relative;
  backdrop-filter: blur(30px);
  -webkit-backdrop-filter: blur(30px);
  box-sizing: border-box;
}

.era-modal-close {
  position: absolute;
  top: 24rpx;
  right: 32rpx;
  font-size: 36rpx;
  color: rgba(255, 255, 255, 0.4);
  padding: 16rpx;
}

.era-modal-year {
  font-size: 80rpx;
  font-weight: 100;
  color: rgba(255, 255, 255, 0.12);
  display: block;
  line-height: 1;
}

.era-modal-title {
  font-size: 36rpx;
  font-weight: 500;
  color: #ffffff;
  display: block;
  margin: 16rpx 0 32rpx;
  letter-spacing: 0;
}

.era-modal-img {
  width: 100%;
  border-radius: 12rpx;
  margin-bottom: 32rpx;
  opacity: 0.9;
}

.era-modal-text {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.65);
  line-height: 1.9;
  letter-spacing: 0;
}

.era-modal-video-wrap {
  margin-top: 32rpx;
}

.era-modal-video {
  width: 100%;
  border-radius: 12rpx;
}

.era-modal-btn {
  margin-top: 40rpx;
  padding: 24rpx 0;
  text-align: center;
  border: 1rpx solid rgba(242, 201, 76, 0.4);
  border-radius: 48rpx;
  color: #F2C94C;
  font-size: 28rpx;
  letter-spacing: 0;
}

@keyframes fadeIn {
  from {
    opacity: 0;
  }

  to {
    opacity: 1;
  }
}
