page {
  width: 100%;
  height: 100%;
  background: #1a0a00;
  overflow: hidden;
}

.home-page {
  position: relative;
  height: 100vh;
  background: #1a0a00;
  color: #ffffff;
  overflow: hidden;
}

.home-swiper {
  width: 100%;
  height: 100vh;
}

.section-screen {
  position: relative;
  width: 100%;
  height: 100vh;
  overflow: hidden;
  opacity: 0;
  transform: translateY(44rpx) scale(0.98);
  transition: opacity 0.55s ease, transform 0.55s ease;
  box-sizing: border-box;
}

.section-screen.visible {
  opacity: 1;
  transform: translateY(0) scale(1);
}

.section-inner {
  position: relative;
  z-index: 2;
  height: 100vh;
  padding: 92rpx 48rpx 72rpx;
  box-sizing: border-box;
}

.center-inner {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.hero-section {
  background: #1a0a00;
}

.bg-video {
  position: absolute;
  top: 0;
  left: 0;
  z-index: 0;
  width: 100%;
  height: 100%;
  opacity: 0.25;
}

.hero-shade {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 1;
  background: rgba(26, 10, 0, 0.34);
}

.music-toggle {
  position: absolute;
  top: 52rpx;
  right: 42rpx;
  z-index: 4;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  border: 4rpx solid #000000;
  background: #F2C94C;
  color: #000000;
  box-shadow: 8rpx 8rpx 0 #000000;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 38rpx;
  font-weight: 900;
  box-sizing: border-box;
}

.music-toggle.playing {
  animation: rotate 3s linear infinite;
}

.hero-content {
  position: relative;
  z-index: 2;
  height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 52rpx;
  text-align: center;
  box-sizing: border-box;
}

.hero-copy {
  opacity: 0;
  transform: translateY(30rpx);
  transition: opacity 0.7s ease, transform 0.7s ease;
}

.hero-copy.hero-ready {
  opacity: 1;
  transform: translateY(0);
}

.logo-stamp {
  width: 300rpx;
  margin: 0 auto 42rpx;
  padding: 22rpx 20rpx;
  border: 6rpx solid #000000;
  border-radius: 16rpx;
  background: #ffffff;
  box-shadow: 14rpx 14rpx 0 #000000;
  transform: rotate(-3deg);
  box-sizing: border-box;
}

.logo-line {
  display: block;
  font-size: 52rpx;
  line-height: 1.02;
  font-weight: 900;
  text-shadow: 4rpx 4rpx 0 #000000;
}

.logo-line.red {
  color: #D42F2F;
}

.logo-line.yellow {
  color: #F2C94C;
}

.logo-line.blue {
  color: #2D5DA1;
}

.hero-title {
  display: block;
  color: #F2C94C;
  font-size: 72rpx;
  line-height: 1.14;
  font-weight: 900;
  text-shadow: 8rpx 8rpx 0 #000000;
}

.hero-subtitle {
  display: block;
  margin-top: 26rpx;
  color: rgba(255, 255, 255, 0.7);
  font-size: 30rpx;
  line-height: 1.35;
  font-weight: 700;
}

.scroll-cue {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 58rpx;
  z-index: 3;
  display: flex;
  flex-direction: column;
  align-items: center;
  animation: float 2s ease-in-out infinite;
}

.arrow {
  color: #F2C94C;
  font-size: 56rpx;
  line-height: 1;
  font-weight: 900;
  text-shadow: 4rpx 4rpx 0 #000000;
}

.cue-text {
  margin-top: 10rpx;
  color: rgba(255, 255, 255, 0.82);
  font-size: 24rpx;
  line-height: 1.35;
  font-weight: 800;
}

.timeline-section {
  background: #1a0a00;
}

.timeline-scroll {
  width: 100%;
}

.timeline-content {
  min-height: 100vh;
  padding: 92rpx 44rpx 96rpx;
  box-sizing: border-box;
}

.section-title {
  display: inline-block;
  max-width: 100%;
  padding: 16rpx 28rpx;
  border: 4rpx solid #000000;
  border-radius: 16rpx;
  background: #D42F2F;
  color: #ffffff;
  box-shadow: 12rpx 12rpx 0 #000000;
  font-size: 52rpx;
  line-height: 1.15;
  font-weight: 900;
  box-sizing: border-box;
}

.yellow-title {
  background: #F2C94C;
  color: #000000;
}

.timeline-list {
  position: relative;
  margin-top: 58rpx;
  padding: 0 0 16rpx 96rpx;
  box-sizing: border-box;
}

.timeline-list::before {
  content: '';
  position: absolute;
  top: 12rpx;
  bottom: 0;
  left: 60rpx;
  width: 4rpx;
  background: #F2C94C;
}

.timeline-item {
  position: relative;
  margin-bottom: 54rpx;
}

.timeline-node {
  position: absolute;
  top: 18rpx;
  left: -44rpx;
  z-index: 2;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  border: 4rpx solid #000000;
  background: #D42F2F;
  box-sizing: border-box;
}

.era-label {
  display: inline-block;
  margin-bottom: 24rpx;
  padding: 8rpx 24rpx;
  border: 3rpx solid #000000;
  background: #F2C94C;
  color: #000000;
  box-shadow: 6rpx 6rpx 0 #000000;
  font-size: 26rpx;
  line-height: 1.3;
  font-weight: 900;
  box-sizing: border-box;
}

.timeline-card {
  padding: 28rpx 26rpx 30rpx;
  border: 4rpx solid #000000;
  border-radius: 16rpx;
  background: #2D1810;
  color: #ffffff;
  box-shadow: 12rpx 12rpx 0 #000000;
  box-sizing: border-box;
}

.highlight-card {
  background: #D42F2F;
}

.timeline-title {
  display: block;
  color: #F2C94C;
  font-size: 36rpx;
  line-height: 1.25;
  font-weight: 900;
}

.timeline-desc {
  display: block;
  margin-top: 18rpx;
  color: rgba(255, 255, 255, 0.88);
  font-size: 26rpx;
  line-height: 1.68;
  font-weight: 700;
}

.timeline-image {
  display: block;
  width: 100%;
  height: 300rpx;
  margin-top: 22rpx;
  border: 4rpx solid #000000;
  border-radius: 12rpx;
  box-sizing: border-box;
}

.making-video {
  display: block;
  width: 100%;
  height: 320rpx;
  margin-top: 20rpx;
  border: 4rpx solid #000000;
  border-radius: 16rpx;
  background: #000000;
  box-sizing: border-box;
}

.timeline-cta {
  display: inline-block;
  margin-top: 26rpx;
  padding: 18rpx 28rpx;
  border: 4rpx solid #000000;
  border-radius: 16rpx;
  background: #F2C94C;
  color: #000000;
  box-shadow: 8rpx 8rpx 0 #000000;
  font-size: 30rpx;
  line-height: 1.25;
  font-weight: 900;
}

.gallery-section {
  background: #8B4513;
}

.entry-cards {
  display: flex;
  margin-top: 56rpx;
}

.entry-card {
  flex: 1;
  min-width: 0;
  min-height: 390rpx;
  padding: 30rpx 24rpx 28rpx;
  border: 4rpx solid #000000;
  border-radius: 16rpx;
  box-shadow: 12rpx 12rpx 0 #000000;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  box-sizing: border-box;
}

.entry-card + .entry-card {
  margin-left: 24rpx;
}

.red-card {
  background: #D42F2F;
  color: #ffffff;
}

.blue-card {
  background: #2D5DA1;
  color: #ffffff;
}

.entry-icon {
  display: block;
  color: #F2C94C;
  font-size: 56rpx;
  line-height: 1;
  font-weight: 900;
  text-shadow: 5rpx 5rpx 0 #000000;
}

.entry-title {
  display: block;
  margin-top: 28rpx;
  font-size: 38rpx;
  line-height: 1.18;
  font-weight: 900;
}

.entry-button {
  display: block;
  margin-top: 34rpx;
  color: #F2C94C;
  font-size: 28rpx;
  line-height: 1.25;
  font-weight: 900;
}

.preview-scroll {
  width: 100%;
  margin-top: 58rpx;
  white-space: nowrap;
}

.preview-track {
  display: inline-flex;
  padding: 0 20rpx 18rpx 0;
}

.preview-image {
  width: 300rpx;
  height: 400rpx;
  margin-right: 20rpx;
  border: 4rpx solid #000000;
  border-radius: 12rpx;
  background: #2D1810;
  box-sizing: border-box;
}

.ai-section {
  background: linear-gradient(180deg, #1a0a00 0%, #D42F2F 100%);
}

.ai-slogan {
  width: 88%;
  text-align: center;
}

.ai-slogan text {
  display: block;
  color: #ffffff;
  font-size: 62rpx;
  line-height: 1.18;
  font-weight: 900;
  text-shadow: 8rpx 8rpx 0 #000000;
}

.create-button {
  width: 80%;
  margin-top: 70rpx;
  padding: 40rpx 28rpx;
  border: 6rpx solid #000000;
  border-radius: 20rpx;
  background: #F2C94C;
  color: #000000;
  box-shadow: 16rpx 16rpx 0 #000000;
  font-size: 40rpx;
  line-height: 1.25;
  font-weight: 900;
  text-align: center;
  animation: pulse 2s ease-in-out infinite;
  box-sizing: border-box;
}

.nav-dots {
  position: fixed;
  right: 24rpx;
  top: 50%;
  z-index: 999;
  transform: translateY(-50%);
}

.dot {
  width: 16rpx;
  height: 16rpx;
  margin: 24rpx 0;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.3);
  transition: all 0.3s;
}

.dot.active {
  background: #D42F2F;
  transform: scale(1.5);
  box-shadow: 0 0 12rpx #D42F2F;
}

@keyframes float {
  0%,
  100% {
    transform: translateY(0);
  }

  50% {
    transform: translateY(18rpx);
  }
}

@keyframes rotate {
  from {
    transform: rotate(0deg);
  }

  to {
    transform: rotate(360deg);
  }
}

@keyframes pulse {
  0%,
  100% {
    transform: scale(1);
  }

  50% {
    transform: scale(1.03);
  }
}
