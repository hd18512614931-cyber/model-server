page {
  width: 100%;
  height: 100%;
  background: #1a0a00;
  overflow: hidden;
}

.page-root {
  position: relative;
  width: 100vw;
  height: 100vh;
  overflow: hidden;
  color: #ffffff;
}

.global-bg-video {
  position: fixed;
  top: 0;
  left: 0;
  z-index: 0;
  width: 100vw;
  height: 100vh;
  object-fit: cover;
  pointer-events: none;
}

.global-overlay {
  position: fixed;
  top: 0;
  left: 0;
  z-index: 1;
  width: 100vw;
  height: 100vh;
  background: rgba(10, 5, 0, 0.55);
  pointer-events: none;
}

.main-swiper {
  position: relative;
  z-index: 2;
  width: 100vw;
  height: 100vh;
}

.screen {
  position: relative;
  width: 100vw;
  height: 100vh;
  box-sizing: border-box;
  overflow: hidden;
}

.glass-card {
  background: rgba(26, 10, 0, 0.65);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 2rpx solid rgba(255, 255, 255, 0.12);
  border-radius: 24rpx;
  padding: 40rpx;
  box-shadow: 10rpx 10rpx 0 rgba(0, 0, 0, 0.4);
  box-sizing: border-box;
}

.screen-1 {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 0 48rpx;
}

.title-group {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.main-title {
  display: block;
  color: #F2C94C;
  font-size: 72rpx;
  line-height: 1.18;
  font-weight: 900;
  letter-spacing: 0;
  text-shadow: 4rpx 4rpx 0 #000000, 8rpx 8rpx 0 rgba(0, 0, 0, 0.3);
  animation: fadeInUp 1.2s ease-out 0.3s both;
}

.sub-title {
  display: block;
  margin-top: 20rpx;
  color: rgba(255, 255, 255, 0.7);
  font-size: 32rpx;
  line-height: 1.4;
  font-weight: 700;
  letter-spacing: 0;
  animation: fadeInUp 1.2s ease-out 0.8s both;
}

.scroll-hint {
  position: absolute;
  bottom: 120rpx;
  left: 0;
  right: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.arrow-down {
  color: rgba(255, 255, 255, 0.6);
  font-size: 48rpx;
  line-height: 1;
  font-weight: 900;
  animation: float 2s ease-in-out infinite;
}

.hint-text {
  margin-top: 12rpx;
  color: rgba(255, 255, 255, 0.4);
  font-size: 24rpx;
  line-height: 1.35;
  font-weight: 700;
}

.screen-2 {
  padding-top: 1rpx;
}

.section-title {
  display: block;
  margin: 80rpx 0 40rpx;
  color: #F2C94C;
  font-size: 56rpx;
  line-height: 1.16;
  font-weight: 900;
  letter-spacing: 0;
  text-align: center;
  text-shadow: 3rpx 3rpx 0 #000000;
}

.timeline {
  position: relative;
  padding: 20rpx 32rpx 20rpx 80rpx;
}

.tl-line {
  position: absolute;
  left: 60rpx;
  top: 0;
  bottom: 0;
  width: 4rpx;
  background: linear-gradient(180deg, transparent 0%, #F2C94C 15%, #F2C94C 85%, transparent 100%);
}

.tl-node {
  position: relative;
  margin-bottom: 40rpx;
  padding-left: 40rpx;
}

.tl-dot {
  position: absolute;
  left: -28rpx;
  top: 24rpx;
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: #D42F2F;
  border: 4rpx solid #F2C94C;
  box-shadow: 0 0 12rpx rgba(212, 47, 47, 0.6);
  box-sizing: border-box;
}

.tl-label {
  padding: 24rpx 28rpx;
  border-left: 6rpx solid #F2C94C;
}

.tl-highlight {
  border-color: rgba(212, 47, 47, 0.75);
  border-left-color: #D42F2F;
}

.tl-era {
  display: inline-block;
  background: #F2C94C;
  color: #000000;
  font-size: 22rpx;
  line-height: 1.35;
  font-weight: 900;
  padding: 4rpx 16rpx;
  border: 2rpx solid #000000;
  box-shadow: 4rpx 4rpx 0 #000000;
}

.tl-brief {
  display: block;
  margin-top: 16rpx;
  color: rgba(255, 255, 255, 0.9);
  font-size: 30rpx;
  line-height: 1.3;
  font-weight: 900;
}

.screen-3 {
  padding-top: 1rpx;
}

.preview-scroll {
  width: 100%;
  white-space: nowrap;
  padding: 32rpx;
  box-sizing: border-box;
}

.preview-img {
  display: inline-block;
  width: 240rpx;
  height: 320rpx;
  margin-right: 20rpx;
  padding: 0;
  border: 4rpx solid #000000;
  border-radius: 16rpx;
  box-shadow: 8rpx 8rpx 0 rgba(0, 0, 0, 0.4);
  background: rgba(26, 10, 0, 0.65);
  vertical-align: top;
}

.gallery-entries {
  display: flex;
  padding: 0 32rpx;
  margin-top: 40rpx;
}

.entry-card {
  flex: 1;
  min-width: 0;
  min-height: 300rpx;
  padding: 36rpx 24rpx;
  border-radius: 24rpx;
  border: 4rpx solid #000000;
  box-shadow: 10rpx 10rpx 0 rgba(0, 0, 0, 0.5);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  backdrop-filter: blur(15px);
  -webkit-backdrop-filter: blur(15px);
  box-sizing: border-box;
  text-align: center;
}

.entry-card + .entry-card {
  margin-left: 24rpx;
}

.entry-3d {
  background: rgba(212, 47, 47, 0.75);
  border-top: 12rpx solid #D42F2F;
}

.entry-2d {
  background: rgba(45, 93, 161, 0.75);
  border-top: 12rpx solid #2D5DA1;
}

.entry-icon {
  display: block;
  color: #F2C94C;
  font-size: 64rpx;
  line-height: 1;
  font-weight: 900;
  text-shadow: 4rpx 4rpx 0 #000000;
}

.entry-title {
  display: block;
  margin-top: 16rpx;
  color: #ffffff;
  font-size: 32rpx;
  line-height: 1.25;
  font-weight: 900;
}

.entry-desc {
  display: block;
  margin-top: 16rpx;
  color: rgba(255, 255, 255, 0.68);
  font-size: 22rpx;
  line-height: 1.35;
  font-weight: 700;
}

.entry-arrow {
  display: block;
  margin-top: 12rpx;
  color: #F2C94C;
  font-size: 26rpx;
  line-height: 1.3;
  font-weight: 900;
}

.screen-4 {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 0 48rpx;
  background: linear-gradient(180deg, rgba(26, 10, 0, 0.3) 0%, rgba(212, 47, 47, 0.4) 100%);
  text-align: center;
}

.ai-slogan {
  width: 88%;
}

.ai-slogan text {
  display: block;
  color: #ffffff;
  font-size: 62rpx;
  line-height: 1.18;
  font-weight: 900;
  text-shadow: 8rpx 8rpx 0 #000000;
}

.create-button {
  width: 80%;
  margin-top: 70rpx;
  padding: 40rpx 28rpx;
  border: 6rpx solid #000000;
  border-radius: 20rpx;
  background: #F2C94C;
  color: #000000;
  box-shadow: 16rpx 16rpx 0 #000000;
  font-size: 40rpx;
  line-height: 1.25;
  font-weight: 900;
  text-align: center;
  animation: pulse 2s ease-in-out infinite;
  box-sizing: border-box;
}

.nav-dots {
  position: fixed;
  right: 24rpx;
  top: 50%;
  z-index: 10;
  transform: translateY(-50%);
}

.dot {
  width: 16rpx;
  height: 16rpx;
  margin: 24rpx 0;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.3);
  transition: all 0.3s;
}

.dot.active {
  background: #D42F2F;
  transform: scale(1.5);
  box-shadow: 0 0 12rpx #D42F2F;
}

.music-btn {
  position: fixed;
  top: 80rpx;
  right: 32rpx;
  z-index: 10;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.5);
  border: 3rpx solid rgba(255, 255, 255, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #F2C94C;
  font-size: 36rpx;
  font-weight: 900;
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  box-sizing: border-box;
}

.music-btn.spinning {
  animation: spin 3s linear infinite;
}

.detail-modal {
  position: fixed;
  top: 0;
  left: 0;
  z-index: 100;
  width: 100vw;
  height: 100vh;
  background: rgba(0, 0, 0, 0.7);
  display: flex;
  align-items: center;
  justify-content: center;
}

.detail-content {
  position: relative;
  width: 85vw;
  max-height: 80vh;
  overflow-y: auto;
  padding: 44rpx 36rpx 40rpx;
}

.detail-image {
  display: block;
  width: 100%;
  margin: 20rpx 0;
  border-radius: 12rpx;
  border: 4rpx solid #000000;
  box-sizing: border-box;
}

.detail-era {
  display: inline-block;
  background: #F2C94C;
  color: #000000;
  font-size: 26rpx;
  line-height: 1.35;
  font-weight: 900;
  padding: 8rpx 24rpx;
  border: 3rpx solid #000000;
  box-shadow: 6rpx 6rpx 0 #000000;
}

.detail-title {
  display: block;
  margin: 24rpx 0 16rpx;
  color: #F2C94C;
  font-size: 40rpx;
  line-height: 1.25;
  font-weight: 900;
}

.detail-text {
  display: block;
  color: rgba(255, 255, 255, 0.85);
  font-size: 28rpx;
  line-height: 1.8;
  font-weight: 700;
}

.detail-close {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  width: 56rpx;
  height: 56rpx;
  color: #ffffff;
  font-size: 36rpx;
  line-height: 56rpx;
  text-align: center;
  font-weight: 900;
}

@keyframes float {
  0%,
  100% {
    transform: translateY(0);
  }

  50% {
    transform: translateY(24rpx);
  }
}

@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(40rpx);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes spin {
  from {
    transform: rotate(0deg);
  }

  to {
    transform: rotate(360deg);
  }
}

@keyframes pulse {
  0%,
  100% {
    transform: scale(1);
  }

  50% {
    transform: scale(1.03);
  }
}
