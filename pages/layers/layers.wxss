/* ═══════════ 页面基础 ═══════════ */
page {
  background: #17110d;
  font-family: -apple-system, 'PingFang SC', 'Helvetica Neue', sans-serif;
}

.layers-page {
  width: 100vw;
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: radial-gradient(ellipse at 50% 30%, rgba(196, 30, 58, 0.09), transparent 55%),
              linear-gradient(180deg, #1e1510, #17110d);
}

/* ═══════════ 顶栏 ═══════════ */
.top-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 54rpx 28rpx 12rpx;
  flex-shrink: 0;
  z-index: 50;
}

.top-back {
  width: 68rpx;
  height: 68rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(255, 247, 230, 0.13);
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.3);
  flex-shrink: 0;
}

.top-back-icon {
  color: #fff7e6;
  font-size: 44rpx;
  line-height: 1;
  margin-top: -2rpx;
}

.top-title-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
  min-width: 0;
}

.top-title {
  color: #fff7e6;
  font-size: 32rpx;
  font-weight: 700;
  letter-spacing: 6rpx;
  line-height: 1.3;
}

.top-subtitle {
  color: rgba(255, 241, 207, 0.4);
  font-size: 20rpx;
  letter-spacing: 2rpx;
}

.top-actions {
  display: flex;
  gap: 8rpx;
  flex-shrink: 0;
}

.top-action-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2rpx;
  padding: 6rpx 10rpx;
  border-radius: 10rpx;
  background: rgba(255, 247, 230, 0.05);
  border: 1rpx solid rgba(255, 247, 230, 0.08);
}

.top-action-btn.primary {
  background: rgba(196, 30, 58, 0.15);
  border-color: rgba(196, 30, 58, 0.3);
}

.top-action-icon {
  color: rgba(255, 247, 230, 0.7);
  font-size: 28rpx;
  line-height: 1;
}

.top-action-label {
  color: rgba(255, 247, 230, 0.45);
  font-size: 16rpx;
}

/* ═══════════ 加载态 ═══════════ */
.loading-panel {
  position: fixed;
  inset: 0;
  z-index: 100;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: rgba(23, 17, 13, 0.8);
}

.loading-ring {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  border: 6rpx solid rgba(255, 241, 207, 0.1);
  border-top-color: #e6a817;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.loading-text {
  margin-top: 24rpx;
  color: rgba(255, 247, 230, 0.75);
  font-size: 26rpx;
}

/* ═══════════ 帮助覆盖层 ═══════════ */
.help-overlay {
  position: fixed;
  inset: 0;
  z-index: 80;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(23, 17, 13, 0.75);
}

.help-card {
  width: 560rpx;
  padding: 40rpx;
  border-radius: 24rpx;
  background: #1e1812;
  border: 1rpx solid rgba(255, 247, 230, 0.1);
}

.help-title {
  color: #fff7e6;
  font-size: 30rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  display: block;
  margin-bottom: 16rpx;
}

.help-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.help-item {
  color: rgba(255, 247, 230, 0.65);
  font-size: 24rpx;
  line-height: 1.6;
}

.help-close {
  color: rgba(255, 247, 230, 0.3);
  font-size: 22rpx;
  text-align: center;
}

/* ═══════════ 预览区 ═══════════ */
.preview-section {
  flex-shrink: 0;
  padding: 0 24rpx;
  margin-bottom: 16rpx;
}

/* 堆叠模式 */
.preview-stack {
  position: relative;
  width: 100%;
  height: 300rpx;
  border-radius: 12rpx;
  overflow: hidden;
  border: 1rpx solid rgba(255, 247, 230, 0.06);
}

.stack-paper {
  position: absolute;
  inset: 0;
  background: linear-gradient(135deg, #fdf5e6, #f5e6d3);
  z-index: 0;
}

.stack-layer {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  mix-blend-mode: multiply;
}

.stack-label {
  position: absolute;
  bottom: 10rpx;
  right: 16rpx;
  z-index: 10;
  padding: 4rpx 16rpx;
  border-radius: 16rpx;
  background: rgba(23, 17, 13, 0.55);
}

.stack-label-text {
  color: rgba(255, 247, 230, 0.5);
  font-size: 18rpx;
}

/* 并排模式 */
.preview-grid {
  width: 100%;
  white-space: nowrap;
}

.grid-row {
  display: inline-flex;
  gap: 16rpx;
  padding: 8rpx 0;
}

.grid-cell {
  width: 200rpx;
  flex-shrink: 0;
}

.cell-paper {
  width: 200rpx;
  height: 240rpx;
  border-radius: 10rpx;
  border: 1rpx solid rgba(255, 247, 230, 0.06);
  background: #f5e6d3;
  overflow: hidden;
}

.cell-image {
  width: 100%;
  height: 100%;
}

.cell-dimmed .cell-paper {
  opacity: 0.3;
}

.cell-info {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 4rpx;
}

.cell-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.cell-label {
  color: rgba(255, 247, 230, 0.7);
  font-size: 22rpx;
}

.cell-dimmed .cell-label {
  opacity: 0.3;
}

.cell-order {
  color: rgba(255, 247, 230, 0.25);
  font-size: 18rpx;
  margin-left: auto;
}

/* ═══════════ 透明度面板 ═══════════ */
.opacity-panel {
  flex-shrink: 0;
  padding: 0 28rpx 8rpx;
  border-bottom: 1rpx solid rgba(255, 247, 230, 0.04);
}

.opacity-list {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.opacity-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 4rpx 0;
}

.opacity-dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.opacity-label {
  color: rgba(255, 247, 230, 0.55);
  font-size: 22rpx;
  width: 80rpx;
  flex-shrink: 0;
}

.opacity-slider {
  flex: 1;
  margin: 0;
}

.opacity-value {
  color: rgba(255, 247, 230, 0.35);
  font-size: 20rpx;
  width: 60rpx;
  text-align: right;
  flex-shrink: 0;
}

/* ═══════════ 图层列表 ═══════════ */
.layer-list {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  padding: 0 20rpx 0;
}

.list-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 8rpx 10rpx;
  flex-shrink: 0;
}

.list-header-title {
  color: rgba(255, 247, 230, 0.5);
  font-size: 24rpx;
  font-weight: 600;
  letter-spacing: 3rpx;
}

.list-header-actions {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.header-action {
  color: rgba(196, 30, 58, 0.7);
  font-size: 22rpx;
}

.header-divider {
  color: rgba(255, 247, 230, 0.12);
  font-size: 20rpx;
}

.list-scroll {
  flex: 1;
  min-height: 0;
  padding-bottom: env(safe-area-inset-bottom, 20rpx);
}

/* ── 图层条目 ── */
.layer-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 12rpx;
  margin-bottom: 10rpx;
  border-radius: 16rpx;
  background: rgba(255, 247, 230, 0.03);
  border: 1rpx solid rgba(255, 247, 230, 0.04);
  transition: all 0.25s ease;
  position: relative;
}

.layer-item.item-hidden {
  opacity: 0.4;
  background: rgba(255, 247, 230, 0.015);
}

.layer-item.item-dragging {
  box-shadow: 0 12rpx 36rpx rgba(0, 0, 0, 0.4);
  border-color: rgba(196, 30, 58, 0.35);
  z-index: 100;
}

.item-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex: 1;
  min-width: 0;
}

.item-color-strip {
  width: 8rpx;
  height: 60rpx;
  border-radius: 4rpx;
  flex-shrink: 0;
}

.item-info {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.item-label {
  color: rgba(255, 247, 230, 0.85);
  font-size: 26rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.item-hidden .item-label {
  color: rgba(255, 247, 230, 0.35);
}

.item-desc {
  color: rgba(255, 247, 230, 0.3);
  font-size: 20rpx;
  margin-top: 2rpx;
}

.item-hidden .item-desc {
  color: rgba(255, 247, 230, 0.15);
}

.item-thumb {
  width: 90rpx;
  height: 90rpx;
  border-radius: 10rpx;
  border: 1rpx solid rgba(255, 247, 230, 0.08);
  background: #f5e6d3;
  overflow: hidden;
  flex-shrink: 0;
  position: relative;
}

.item-thumb-img {
  width: 100%;
  height: 100%;
}

.item-thumb-img.thumb-off {
  opacity: 0.25;
}

.thumb-status {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(23, 17, 13, 0.5);
}

.thumb-status-icon {
  color: rgba(255, 247, 230, 0.5);
  font-size: 32rpx;
}

.item-actions {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  flex-shrink: 0;
}

.item-action-btn {
  width: 52rpx;
  height: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 8rpx;
  background: rgba(255, 247, 230, 0.06);
  border: 1rpx solid rgba(255, 247, 230, 0.05);
}

.item-action-btn.disabled {
  opacity: 0.2;
}

.item-action-icon {
  color: rgba(255, 247, 230, 0.45);
  font-size: 24rpx;
  line-height: 1;
}

.item-order-num {
  color: rgba(255, 247, 230, 0.35);
  font-size: 22rpx;
  font-weight: 600;
}
