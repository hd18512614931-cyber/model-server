page {
  background: #17110d;
}

.exploded-page {
  position: relative;
  width: 100vw;
  height: 100vh;
  overflow: hidden;
  box-sizing: border-box;
  padding: 96rpx 32rpx 32rpx;
  background:
    linear-gradient(180deg, rgba(196, 30, 58, 0.26), rgba(23, 17, 13, 0) 34%),
    #17110d;
}

.back-btn {
  position: fixed;
  top: 54rpx;
  left: 28rpx;
  z-index: 50;
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(255, 255, 255, 0.22);
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.38);
}

.back-icon {
  color: #fff7e6;
  font-size: 42rpx;
  line-height: 1;
}

.page-header {
  position: relative;
  z-index: 2;
  text-align: center;
  margin-bottom: 70rpx;
}

.page-title {
  display: block;
  color: #fff1cf;
  font-size: 38rpx;
  font-weight: 700;
  line-height: 1.35;
}

.loading-panel {
  height: 640rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.loading-ring {
  width: 86rpx;
  height: 86rpx;
  border-radius: 50%;
  border: 8rpx solid rgba(255, 241, 207, 0.18);
  border-top-color: #e6a817;
  animation: spin 0.9s linear infinite;
}

@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.loading-text {
  margin-top: 28rpx;
  color: rgba(255, 247, 230, 0.82);
  font-size: 28rpx;
}

.viewer-panel {
  position: relative;
  z-index: 1;
}

.stage {
  width: 600rpx;
  height: 600rpx;
  margin: 0 auto;
  perspective: 1200px;
  cursor: pointer;
}

.layers-container {
  position: relative;
  width: 100%;
  height: 100%;
  transform-style: preserve-3d;
  transform: rotateX(55deg) rotateZ(-30deg);
  transition: transform 0.6s ease;
}

.layer {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  transition: transform 0.8s cubic-bezier(0.34, 1.56, 0.64, 1);
  opacity: 0.92;
  box-shadow: 0 8px 32px rgba(0, 0, 0, 0.25);
}

.legend-row {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 16rpx;
  margin-top: 56rpx;
}

.legend-item {
  display: flex;
  align-items: center;
  height: 46rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.08);
  color: rgba(255, 247, 230, 0.86);
  font-size: 22rpx;
}

.legend-swatch {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  margin-right: 10rpx;
}
