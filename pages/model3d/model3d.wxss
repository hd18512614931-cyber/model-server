page {
  background-color: #1a1a2e;
}

.page {
  min-height: 100vh;
  padding: 40rpx;
  box-sizing: border-box;
}

.header {
  text-align: center;
  margin-bottom: 60rpx;
  padding-top: 20rpx;
}

.header-title {
  display: block;
  font-size: 48rpx;
  font-weight: 900;
  color: #F8E5A9;
  letter-spacing: 6rpx;
  margin-bottom: 16rpx;
}

.header-desc {
  display: block;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.5);
  letter-spacing: 2rpx;
}

.model-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.model-card {
  width: 48%;
  background: rgba(255, 255, 255, 0.08);
  border-radius: 20rpx;
  overflow: hidden;
  margin-bottom: 30rpx;
  border: 1rpx solid rgba(248, 229, 169, 0.15);
  transition: transform 0.2s ease;
}

.model-card:active {
  transform: scale(0.96);
}

.card-cover {
  width: 100%;
  aspect-ratio: 1;
  position: relative;
  overflow: hidden;
  background: linear-gradient(135deg, #2a2a4a 0%, #1a1a2e 100%);
}

.card-cover image {
  width: 100%;
  height: 100%;
}

.card-badge {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  background: linear-gradient(135deg, #D9281C 0%, #aa1a10 100%);
  color: #fff;
  font-size: 20rpx;
  font-weight: bold;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  letter-spacing: 2rpx;
}

.card-info {
  padding: 20rpx 24rpx;
}

.card-name {
  display: block;
  font-size: 28rpx;
  font-weight: bold;
  color: #F8E5A9;
  margin-bottom: 8rpx;
}

.card-desc {
  display: block;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.4);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tip {
  text-align: center;
  color: rgba(255, 255, 255, 0.3);
  font-size: 28rpx;
  margin-top: 200rpx;
}

/* AI 生成入口卡片 */
.ai-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: linear-gradient(135deg, rgba(196, 30, 58, 0.25) 0%, rgba(212, 168, 73, 0.15) 100%);
  border: 1rpx solid rgba(248, 229, 169, 0.3);
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 40rpx;
}

.ai-entry:active {
  opacity: 0.8;
}

.ai-entry-left {
  display: flex;
  align-items: center;
}

.ai-entry-icon {
  font-size: 48rpx;
  margin-right: 20rpx;
}

.ai-entry-title {
  display: block;
  font-size: 28rpx;
  font-weight: bold;
  color: #F8E5A9;
  margin-bottom: 6rpx;
}

.ai-entry-desc {
  display: block;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.4);
}

.ai-entry-arrow {
  font-size: 36rpx;
  color: #F8E5A9;
}

/* 封面图加载失败时的渐变占位 */
.cover-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.cover-placeholder.gradient-warm {
  background: linear-gradient(135deg, #f5af19 0%, #f12711 100%);
}

.cover-placeholder.gradient-blue {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
}

.cover-placeholder.gradient-green {
  background: linear-gradient(135deg, #11998e 0%, #38ef7d 100%);
}

.placeholder-icon {
  font-size: 64rpx;
  margin-bottom: 12rpx;
}

.placeholder-name {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
  font-weight: bold;
  letter-spacing: 2rpx;
}
