<view class="page">
  <view class="header">
    <text class="header-title">3D 年画展厅</text>
    <text class="header-desc">点击模型卡片，全屏沉浸式体验</text>
  </view>

  <!-- AI 生成入口 -->
  <view class="ai-entry" bindtap="goAI3D">
    <view class="ai-entry-left">
      <text class="ai-entry-icon">📷</text>
      <view class="ai-entry-text">
        <text class="ai-entry-title">上传图片，AI 生成 3D 模型</text>
        <text class="ai-entry-desc">Seed3D 2.0 驱动</text>
      </view>
    </view>
    <text class="ai-entry-arrow">→</text>
  </view>

  <view class="model-grid">
    <view
      wx:for="{{models}}"
      wx:key="id"
      class="model-card"
      bindtap="openViewer"
      data-index="{{index}}"
    >
      <view class="card-cover">
        <!-- 图片加载失败时显示渐变占位 -->
        <view wx:if="{{item.coverError}}" class="cover-placeholder {{item.gradient}}">
          <text class="placeholder-icon">🎨</text>
          <text class="placeholder-name">{{item.name}}</text>
        </view>
        <image
          wx:else
          src="{{item.cover}}"
          mode="aspectFill"
          binderror="onCoverError"
          data-index="{{index}}"
        ></image>
        <view class="card-badge">3D</view>
      </view>
      <view class="card-info">
        <text class="card-name">{{item.name}}</text>
        <text class="card-desc">{{item.desc}}</text>
      </view>
    </view>
  </view>

  <view class="tip" wx:if="{{models.length === 0}}">
    <text>暂无 3D 模型</text>
  </view>
</view>
