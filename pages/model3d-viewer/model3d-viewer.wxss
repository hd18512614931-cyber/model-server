page {
  background-color: #0a0a14;
}

.viewer-page {
  width: 100vw;
  height: 100vh;
  position: relative;
  overflow: hidden;
  background: #0a0a14;
}

/* 悬浮返回按钮 */
.float-back-btn {
  position: fixed;
  top: 40rpx;
  left: 30rpx;
  width: 72rpx;
  height: 72rpx;
  background: rgba(255, 255, 255, 0.25);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 150;
}

.float-back-btn:active {
  background: rgba(255, 255, 255, 0.4);
}

.float-back-icon {
  color: #fff;
  font-size: 38rpx;
  font-weight: bold;
}

/* 底部模型名称 */
.model-name-bar {
  position: absolute;
  bottom: calc(env(safe-area-inset-bottom, 0px) + 100rpx);
  left: 0;
  width: 100%;
  text-align: center;
  z-index: 100;
}

.model-name-text {
  color: #F8E5A9;
  font-size: 30rpx;
  font-weight: bold;
  letter-spacing: 2rpx;
}

/* 底部提示 */
.hint-bar {
  position: absolute;
  bottom: calc(env(safe-area-inset-bottom, 0px) + 40rpx);
  left: 0;
  width: 100%;
  text-align: center;
  z-index: 100;
}

.hint-text {
  color: rgba(255, 255, 255, 0.35);
  font-size: 24rpx;
  letter-spacing: 4rpx;
  background: rgba(0, 0, 0, 0.3);
  padding: 12rpx 40rpx;
  border-radius: 30rpx;
}

/* 加载遮罩 */
.loading-mask {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(10, 10, 20, 0.9);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  z-index: 200;
}

.spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid rgba(248, 229, 169, 0.2);
  border-top-color: #F8E5A9;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-bottom: 30rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  color: rgba(248, 229, 169, 0.6);
  font-size: 26rpx;
  letter-spacing: 4rpx;
}
